LALA_API_KEY=replace-me
LALA_SIGNING_SECRET=replace-with-an-independent-secret
LALA_PUBLIC_BASE_URL=http://127.0.0.1:8000
LALA_ASSET_TTL_SECONDS=86400
LALA_RATE_LIMIT_PER_MINUTE=60
LALA_IMAGEGEN_MAX_ATTEMPTS=3
LALA_IMAGEGEN_MAX_CALLS_PER_HOUR=20
LALA_ENABLE_LOCAL_UPLOADS=true

# 모든 추천 판단은 Hermes LLM이 수행합니다.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_MAX_ATTEMPTS=3
HERMES_CIRCUIT_FAILURES=5
HERMES_CIRCUIT_RECOVERY_SECONDS=30

# Hermes Slack Gateway: placeholder ID를 실제 allowlist로 교체하세요.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=U0000000000
SLACK_HOME_CHANNEL=C0000000000

# Generate AI는 로그인된 Codex CLI의 내장 $imagegen을 사용합니다.
LALA_CODEX_EXECUTABLE=codex
# LALA_PLANNER_PROMPT=/absolute/path/to/skills/lala-coordinator/references/planner-prompt.md
